{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account data with admin role assignment",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "PortfolioMain": {
      "title": "Main Portfolio Configuration",
      "description": "General profile info, bio, education, skills, and links",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "title": { "type": "string" },
        "affiliation": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "education": { "type": "object" },
        "researchInterests": { "type": "array" },
        "quantitativeToolkit": { "type": "array" },
        "skills": { "type": "array" },
        "socialLinks": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    },
    "Publication": {
      "title": "Publication or Working Paper",
      "description": "Research paper item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "authors": { "type": "string" },
        "year": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "under_review", "working_paper"] },
        "journalOrVenue": { "type": "string" },
        "abstract": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array" },
        "doi": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "methodology": { "type": "string" },
        "dataset": { "type": "string" },
        "keyFindings": { "type": "array" },
        "bibtex": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "authors", "year", "status"]
    },
    "ResearchTimeline": {
      "title": "Research Timeline Item",
      "description": "Research experience or fellowship entry",
      "type": "object",
      "properties": {
        "period": { "type": "string" },
        "title": { "type": "string" },
        "supervisorOrRole": { "type": "string" },
        "institution": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "tags": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["period", "title"]
    },
    "Award": {
      "title": "Award or Conference Item",
      "description": "Awards, scholarships, conference, and course item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["conference", "award", "course"] },
        "tag": { "type": "string" },
        "secondaryTag": { "type": "string" },
        "icon": { "type": "string" },
        "year": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "category", "tag"]
    },
    "Experience": {
      "title": "Experience Item",
      "description": "Teaching, fellowship, or leadership record",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "organization": { "type": "string" },
        "location": { "type": "string" },
        "period": { "type": "string" },
        "category": { "type": "string", "enum": ["teaching", "fellowship", "leadership", "research"] },
        "description": { "type": "array" },
        "skills": { "type": "array" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["role", "organization", "period", "category"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Messages sent by site visitors",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "purpose": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User records and admin permissions",
      "allow": {
        "read": "request.auth != null",
        "write": "request.auth != null && (request.auth.uid == userId || request.auth.token.email.lower() == 'fahimhaider0124@gmail.com')"
      }
    },
    "/portfolio_data/{docId}": {
      "schema": "PortfolioMain",
      "description": "Global portfolio configuration",
      "allow": {
        "read": "true",
        "write": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))"
      }
    },
    "/publications/{pubId}": {
      "schema": "Publication",
      "description": "Academic publications",
      "allow": {
        "read": "true",
        "write": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))"
      }
    },
    "/research_timeline/{itemId}": {
      "schema": "ResearchTimeline",
      "description": "Research timeline items",
      "allow": {
        "read": "true",
        "write": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))"
      }
    },
    "/awards/{awardId}": {
      "schema": "Award",
      "description": "Awards and honors",
      "allow": {
        "read": "true",
        "write": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))"
      }
    },
    "/experience/{expId}": {
      "schema": "Experience",
      "description": "Experience records",
      "allow": {
        "read": "true",
        "write": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))"
      }
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Visitor contact inquiries",
      "allow": {
        "read": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))",
        "create": "true",
        "update": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))",
        "delete": "request.auth != null && (request.auth.token.email.lower() == 'fahimhaider0124@gmail.com' || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))"
      }
    }
  }
}
